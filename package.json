{
  "name": "claims-bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "node scripts/verify-db.mjs",
    "env:check": "node scripts/check-env.mjs",
    "production:check": "node scripts/check-env.mjs --production && npm run content:check && npm run db:verify",
    "production:smoke": "node scripts/smoke-production.mjs",
    "staff:bootstrap": "node --import tsx scripts/bootstrap-staff.ts",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-staff.ts",
    "test:claims": "node --import tsx --test tests/claims-domain.test.ts",
    "content:check": "npm run test:claims"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@clerk/nextjs": "^7.8.2",
    "@neondatabase/serverless": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svix": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
