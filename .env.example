# Existing application database configuration
DATABASE_URL=postgresql://user:password@host/database

# Cloudflare R2 private bucket configuration (server-only)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=claims-bridge-development

# Transactional email (server-only). Blank defaults cannot activate delivery.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CLAIMS_BRIDGE_FROM_EMAIL=
CLAIMS_BRIDGE_REPLY_TO_EMAIL=
# At least 32 random characters. Bearer header only; also configure the scheduler repository secret.
COMMUNICATIONS_CRON_SECRET=
# Exact comma-separated addresses controlled by developers. No wildcard or implicit rerouting.
# Applies to local development, tests, and Vercel preview builds, even with a real provider key.
COMMUNICATIONS_DEV_RECIPIENT_ALLOWLIST=
NEXT_PUBLIC_SITE_URL=https://claimsbridge.co.uk
